# ---------------------------------------------------------------------------
# Variables marked REQUIRED have no default and no fallback. The service that
# reads each one now refuses to start rather than coming up with a guessable
# credential or with authentication disabled. Copy this file to .env and fill
# them in before the first `start-silver.sh`.
# ---------------------------------------------------------------------------

# REQUIRED. Rspamd web UI / controller password.
# The controller can whitelist senders, retrain the Bayes classifier and disable
# filtering outright, so a guessable value here is enough to turn off spam and
# antivirus protection for the whole deployment. There is no longer a fallback to
# "admin"; config generation aborts while this is empty.
#   openssl rand -base64 24
RSPAMD_PASSWORD=

# Optional. Separate password guarding Rspamd's privileged controller actions
# (learn, fuzzy, config write). Unset, the read-only password above is reused —
# never weaker than read access, but a distinct value is stronger.
RSPAMD_ENABLE_PASSWORD=

# Thunder admin credentials (used during initial setup)
# THUNDER_ADMIN_PASSWORD is REQUIRED and has no default. Thunder authenticates
# every IMAP and SMTP login in the stack and its API is published on port 8090,
# so this account is a full compromise of the mail server if it is guessable.
# Bootstrap refuses to run while it is empty. Generate a strong value with:
#   openssl rand -base64 24
THUNDER_ADMIN_USERNAME=admin
THUNDER_ADMIN_PASSWORD=

# CONSOLE application id, needed by raven to resolve a user's OU to a mail domain
# during login. Leave empty for the first bring-up: Thunder's bootstrap mints a new
# UUID on every install, so no committed value can be correct. Read it after the
# first start and set it here, then restart raven:
#   docker exec silver-thunder sqlite3 -json \
#     /opt/thunder/repository/database/configdb.db \
#     "select ID, json_extract(APP_JSON,'\$.properties.url') from APPLICATION;"
# Use the entry whose url ends in /console.
#
# Raven previously scraped this from `docker logs thunder-setup`, which is why it
# was given a mount of the Docker socket — read-only access to which is still full
# Docker API access, and so full host root. The mount is gone; this replaces it.
THUNDER_APP_ID=

# Public IP of this mail server
MAIL_SERVER_IP=

# REQUIRED. Grafana admin credentials.
# These are passed straight through to GF_SECURITY_ADMIN_USER/PASSWORD, so leaving
# them empty does not fall back to Grafana's built-in default — it overrides that
# default with an empty string. The dashboard renders mail-flow metrics and Postfix
# logs via Loki. It is now bound to 127.0.0.1, so reach it over an SSH tunnel:
#   ssh -L 3000:127.0.0.1:3000 <host>
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=

# Please use single quotes for the webhook URL to avoid issues with special characters
GOOGLE_CHAT_WEBHOOK_URL=''

# Metadata Service Environment Configuration

# ClamAV Database Path (should match volume mount)
CLAMAV_DB_PATH=/var/lib/clamav

# External API URL (Super Platform endpoint to push metadata to)
# Example: https://super-platform.example.com/api/metadata/receive
EXTERNAL_API_URL=

# Push interval in seconds (how often to send metadata to external API)
PUSH_INTERVAL_SECONDS=60

# Enable/disable periodic push service (true/false)
ENABLE_PUSH_SERVICE=true

# REQUIRED. Shared secret authenticating callers of the metadata service API.
# This previously defaulted to empty, and the service treated an empty key as
# "authentication not configured" and served requests unauthenticated — on a port
# that was published to the host. It now refuses to start while this is empty, so
# copying this file verbatim will (correctly) fail until you set it.
#   openssl rand -hex 32
API_KEY=